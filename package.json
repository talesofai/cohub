{
  "name": "cohub",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @cohub/api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:agent": "pnpm --filter @cohub/agent dev",
    "build": "pnpm -r build",
    "build:agent": "pnpm --filter @cohub/agent... build",
    "build:api": "pnpm --filter @cohub/api... build",
    "build:gateway": "pnpm --filter @cohub/gateway... build",
    "build:worker": "pnpm --filter @cohub/worker... build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "node scripts/test/workspaces.mjs",
    "typecheck": "pnpm -r typecheck",
    "test:lsp": "(cd apps/sandbox && go test ./lsp ./process ./env ./rpc ./ws) && pnpm --filter @cohub/agent... build && pnpm --filter @cohub/agent typecheck && pnpm --filter @cohub/agent exec tsx src/tests/lsp-contract.test.ts",
    "format": "biome format --write .",
    "lint:biome": "biome lint .",
    "prepare": "husky",
    "ws:client": "tsx scripts/ws-client.ts",
    "rollout:sandbox": "tsx scripts/rollout-sandbox.ts",
    "rollout:sandbox:prod": "tsx scripts/rollout-sandbox-prod.ts",
    "rollout:sandbox:dev": "tsx scripts/rollout-sandbox-dev.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @neta-art/cohub-cli... build && changeset publish",
    "changelog:generate": "tsx scripts/changelog/generate.ts",
    "changelog:render": "tsx scripts/changelog/render.ts",
    "changelog:release": "tsx scripts/changelog/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "^2.31.0",
    "@napi-rs/canvas": "1.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "basedpyright": "1.39.9",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-lsp": "npm:typescript@6.0.3",
    "typescript-language-server": "5.3.0",
    "zod": "^4.4.3"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "7"
      }
    },
    "overrides": {
      "ioredis": "5.11.1"
    }
  }
}
