{
  "name": "@neta-art/cohub",
  "version": "1.11.0",
  "description": "Cohub SDK for spaces, sessions, checkpoints, and realtime agent collaboration.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/talesofai/cohub.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/talesofai/cohub",
  "keywords": [
    "cohub",
    "sdk",
    "ai",
    "agent",
    "spaces",
    "realtime",
    "websocket"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    },
    "./debugger": {
      "types": "./dist/debugger.d.ts",
      "import": "./dist/debugger.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@cohub/protocol": "workspace:*",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
