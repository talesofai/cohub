{
  "name": "@neta-art/cohub",
  "version": "2.10.0",
  "description": "Cohub SDK for spaces, sessions, checkpoints, and realtime agent collaboration.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/talesofai/cohub.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/talesofai/cohub",
  "keywords": [
    "cohub",
    "sdk",
    "ai",
    "agent",
    "spaces",
    "realtime",
    "websocket"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./http": {
        "types": "./dist/http.d.ts",
        "import": "./dist/http.js"
      },
      "./websocket": {
        "types": "./dist/websocket.d.ts",
        "import": "./dist/websocket.js"
      },
      "./voice-input": {
        "types": "./dist/voice-input.d.ts",
        "import": "./dist/voice-input.js"
      },
      "./debugger": {
        "types": "./dist/debugger.d.ts",
        "import": "./dist/debugger.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "import": "./src/http.ts"
    },
    "./websocket": {
      "types": "./src/websocket.ts",
      "import": "./src/websocket.ts"
    },
    "./voice-input": {
      "types": "./src/voice-input.ts",
      "import": "./src/voice-input.ts"
    },
    "./debugger": {
      "types": "./src/debugger.ts",
      "import": "./src/debugger.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cohub/protocol": "workspace:*",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3"
  }
}
