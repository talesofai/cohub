{
  "name": "@neta-art/cohub-protocol",
  "version": "1.3.0",
  "description": "Shared protocol definitions for the Cohub agent collaboration platform.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/talesofai/cohub.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/talesofai/cohub",
  "keywords": [
    "cohub",
    "protocol",
    "agent",
    "spaces",
    "checkpoints",
    "collaboration",
    "realtime",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./model": {
      "types": "./dist/model/session.d.ts",
      "default": "./dist/model/session.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./task": {
      "types": "./dist/task/index.d.ts",
      "default": "./dist/task/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "default": "./dist/fs/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260421.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
