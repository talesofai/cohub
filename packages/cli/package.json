    "@neta-art/generation": "^0.1.25",
    "@openai/codex-sdk": "0.153.4",
    "commander": "^15.0.0",
    "pixi.js": "^8.20.1",
    "sharp": "^0.35.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cohub/local-runtime": "workspace:*",
    "@cohub/protocol": "workspace:*",
