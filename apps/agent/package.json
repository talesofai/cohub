{
  "name": "@cohub/agent",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-shell-assets.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "node ../../scripts/test/run.mjs --test-isolation=none 'src/tests/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/identity": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-client": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-ioredis": "^0.68.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^5.80.2",
    "bullmq-otel": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "5.11.1",
    "ignore": "^7.0.6",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
