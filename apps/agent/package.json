{
  "name": "@cohub/agent",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsgo -p tsconfig.build.json && tsx scripts/copy-shell-assets.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@earendil-works/pi-agent-core": "0.79.8",
    "@earendil-works/pi-ai": "0.79.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-ioredis": "^0.66.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "bullmq": "^5.77.6",
    "bullmq-otel": "^1.3.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "5.10.1",
    "ignore": "^7.0.5",
    "postgres": "^3.4.9",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
