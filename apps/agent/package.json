{
  "name": "@cohub/agent",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "typecheck": "tsgo -p tsconfig.typecheck.json --noEmit",
    "start": "node dist/index.js",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@cohub/agent-sandbox-protocol": "workspace:*",
    "@neta-art/cohub-protocol": "workspace:*",
    "@cohub/tracing": "workspace:*",
    "@mariozechner/pi-agent-core": "0.70.0",
    "@mariozechner/pi-ai": "0.70.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.215.0",
    "@opentelemetry/instrumentation-http": "^0.215.0",
    "@opentelemetry/instrumentation-ioredis": "^0.63.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "ioredis": "^5.10.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "@cohub/config-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
