{
  "name": "@cohub/worker",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:system": "tsx watch src/entrances/system-worker.ts",
    "build": "tsgo -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:system": "node dist/entrances/system-worker.js",
    "test:trigger-echo": "tsx src/test-helpers.ts trigger-echo",
    "test:trigger": "tsx src/test-helpers.ts trigger",
    "test:list-scheduled": "tsx src/test-helpers.ts list-scheduled"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@cohub/billing": "workspace:*",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@neta-art/generation": "^0.1.13",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-ioredis": "^0.66.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@smithy/node-http-handler": "^4.7.5",
    "bullmq": "^5.77.6",
    "bullmq-otel": "^1.3.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ignore": "^7.0.5",
    "ioredis": "5.10.1",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "tsx": "4.22.3",
    "typescript": "^6.0.3"
  }
}
