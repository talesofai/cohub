# Redis 连接字符串 (必填)
# 本地开发默认使用 localhost:6379
REDIS_URL="redis://localhost:6379"

# Gateway 对外 HTTP 服务端口
PORT="8788"

# Cohub API 基础地址，用于鉴权和 session 写入
API_BASE_URL="http://localhost:8787"

# 调用 API internal endpoint 的服务间密钥，需要与 API 的 WORKER_SECRET 一致
WORKER_SECRET=""

# 火山 ASR API Key，供 /asr/ws 语音输入使用
VOLC_ASR_API_KEY=""

# 火山 ASR 端点和二遍识别调参
VOLC_ASR_END_WINDOW_SIZE_MS="600"
VOLC_ASR_FORCE_TO_SPEECH_TIME_MS="1000"
VOLC_ASR_ENABLE_NONSTREAM="true"
VOLC_ASR_ENABLE_PUNCTUATION="true"
VOLC_ASR_ENABLE_ITN="true"
VOLC_ASR_ENABLE_DDC="false"

# 火山自学习平台词表，可选
VOLC_ASR_BOOSTING_TABLE_NAME=""
VOLC_ASR_BOOSTING_TABLE_ID=""
VOLC_ASR_CORRECT_TABLE_NAME=""
VOLC_ASR_CORRECT_TABLE_ID=""

# 火山 ASR 参数实验，可选。按 user/request 稳定分流，默认关闭。
VOLC_ASR_EXPERIMENT_NAME=""
# JSON: [{"name":"fast-600","weight":1,"options":{"endWindowSizeMs":600,"forceToSpeechTimeMs":1000}},{"name":"patient-1200","weight":1,"options":{"endWindowSizeMs":1200}}]
VOLC_ASR_EXPERIMENT_VARIANTS=""

# ASR LLM 改写，可选。默认关闭；未配置 key 时不会外呼。
ASR_REWRITE_ENABLED="false"
ASR_REWRITE_BASE_URL="https://api.openai.com/v1"
ASR_REWRITE_API_KEY=""
ASR_REWRITE_MODEL="gpt-4.1-mini"
ASR_REWRITE_TIMEOUT_MS="1800"

# 真实火山 ASR 参数实验脚本，可选。音频必须是 16k mono PCM raw。
# VOLC_ASR_EXPERIMENT_AUDIO="/path/to/sample.pcm"
# pnpm --filter @cohub/gateway asr:experiment

# ==========================================
# 本地调试模式配置 (仅供本地单测 Gateway 使用)
# ==========================================
# 开启调试模式后，Gateway 会自动监听 Inbound 消息并回复 Pong
DEBUG_MODE="true"

# ----------------- Discord -----------------
# 填入此项后，Gateway 启动时将自动拉起一个 Discord Bot
# DEBUG_DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# ----------------- Telegram -----------------
# (预留给后续的 Telegram Provider)
# DEBUG_TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# ----------------- Feishu -------------------
# 填入此项后，Gateway 启动时将自动拉起一个 Feishu Bot (WebSocket 长连接)
# DEBUG_FEISHU_APP_ID="cli_xxx"
# DEBUG_FEISHU_APP_SECRET="xxx"
# DEBUG_FEISHU_BRAND="feishu"
