# Redis 连接字符串 (必填)
# 本地开发默认使用 localhost:6379
REDIS_URL="redis://localhost:6379"

# Gateway 对外 HTTP 服务端口
PORT="8788"

# Cohub API 基础地址，用于鉴权和 session 写入
API_BASE_URL="http://localhost:8787"

# 中心化 Discord 服务地址与鉴权密钥
DISCORD_CENTRAL_BASE_URL="http://localhost:8790"
DISCORD_CENTRAL_SECRET="please-change-me"
DISCORD_CENTRAL_TIMEOUT_MS="10000"

# ==========================================
# 本地调试模式配置 (仅供本地单测 Gateway 使用)
# ==========================================
# 开启调试模式后，Gateway 会自动监听 Inbound 消息并回复 Pong
DEBUG_MODE="true"

# ----------------- Discord -----------------
# 填入此项后，Gateway 启动时将自动拉起一个 Discord Bot
# DEBUG_DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# ----------------- Telegram -----------------
# (预留给后续的 Telegram Provider)
# DEBUG_TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# ----------------- Feishu -------------------
# 填入此项后，Gateway 启动时将自动拉起一个 Feishu Bot (WebSocket 长连接)
# DEBUG_FEISHU_APP_ID="cli_xxx"
# DEBUG_FEISHU_APP_SECRET="xxx"
# DEBUG_FEISHU_BRAND="feishu"
