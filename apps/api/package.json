{
  "name": "@cohub/api",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsgo -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "start": "node --import ./dist/register-otel-esm-hook.js dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:data:v2": "tsx src/db/migrate-v2-data.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@cohub/billing": "workspace:*",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/identity": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@cohub/space-fs": "workspace:*",
    "@hono/node-server": "2.0.4",
    "@hono/otel": "^1.1.2",
    "@kubernetes/client-node": "^1.4.0",
    "@neta-art/generation": "^0.1.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-ioredis": "^0.66.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@talesofai-billing/sdk": "^1.6.0",
    "bullmq": "^5.77.6",
    "bullmq-otel": "^1.3.1",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.23",
    "ignore": "^7.0.5",
    "ioredis": "5.10.1",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.22.3",
    "typescript": "^6.0.3"
  }
}
