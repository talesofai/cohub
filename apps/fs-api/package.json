    "@cohub/protocol": "workspace:*",
    "@cohub/space-fs": "workspace:*",
    "@hono/node-server": "2.0.4",
    "@hono/otel": "^1.1.2",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.23",
    "ioredis": "5.10.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "25.9.1",
    "typescript": "^6.0.3"
  }
