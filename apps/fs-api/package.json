{
  "name": "@cohub/fs-api",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsgo -p tsconfig.build.json",
    "lint": "biome lint .",
